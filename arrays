public class Main {
    public static void main(String[] args) {

        // 1. Array Traversal
        int[] array1 = {10, 20, 30, 40, 50};

        System.out.println("1. ARRAY TRAVERSAL");
        for (int i = 0; i < array1.length; i++) {
            System.out.println("Array value: " + array1[i]);
        }

        // 2. Sum of Array
        int[] array2 = {5, 10, 15, 20, 25};

        int sum = 0;

        for (int i = 0; i < array2.length; i++) {
            sum = sum + array2[i];
        }

        System.out.println("\n2. SUM OF ARRAY");
        System.out.println("Sum = " + sum);


        // 3. Subtraction of Array
        int[] array3 = {50, 10, 5, 2};

        int sub = array3[0];

        for (int i = 1; i < array3.length; i++) {
            sub = sub - array3[i];
        }

        System.out.println("\n3. SUBTRACTION OF ARRAY");
        System.out.println("Subtraction = " + sub);


        // 4. Multiplication of Array
        int[] array4 = {2, 3, 4, 5};

        int mul = 1;

        for (int i = 0; i < array4.length; i++) {
            mul = mul * array4[i];
        }

        System.out.println("\n4. MULTIPLICATION OF ARRAY");
        System.out.println("Multiplication = " + mul);


        // 5. Even Numbers
        int[] array5 = {11, 24, 37, 42, 55, 68};

        System.out.println("\n5. EVEN NUMBERS");

        for (int i = 0; i < array5.length; i++) {
            if (array5[i] % 2 == 0) {
                System.out.println("Even: " + array5[i]);
            }
        }


        // 6. Odd Numbers
        System.out.println("\n6. ODD NUMBERS");

        for (int i = 0; i < array5.length; i++) {
            if (array5[i] % 2 != 0) {
                System.out.println("Odd: " + array5[i]);
            }
        }


        // 7. Reverse Array
        int[] array6 = {10, 20, 30, 40, 50};

        System.out.println("\n7. REVERSE ARRAY");

        for (int i = array6.length - 1; i >= 0; i--) {
            System.out.println(array6[i]);
        }


        // 8. Largest Number
        int[] array7 = {25, 78, 12, 95, 43};

        int largest = array7[0];

        for (int i = 1; i < array7.length; i++) {
            if (array7[i] > largest) {
                largest = array7[i];
            }
        }

        System.out.println("\n8. LARGEST NUMBER");
        System.out.println("Largest = " + largest);


        // 9. Smallest Number
        int[] array8 = {45, 12, 78, 23, 9};

        int smallest = array8[0];

        for (int i = 1; i < array8.length; i++) {
            if (array8[i] < smallest) {
                smallest = array8[i];
            }
        }

        System.out.println("\n9. SMALLEST NUMBER");
        System.out.println("Smallest = " + smallest);
    }
}
